#!/bin/bash
#
# Generate the ex_doc documentation and commit it to the local gh-pages
# branch, creating that branch if it does not exist yet. The working
# tree and the current branch are not touched: the branch is checked
# out in a temporary git worktree. Nothing is pushed; do that by hand
# (git push origin gh-pages) once the result has been looked at.

set -eu

cd "$(dirname "$0")"
ROOT=$PWD

DOCDIR=apps/blizanci/doc

# The manual is written in gemtext; ex_doc wants the Markdown copies,
# so generate them first (needs gemtext2md; see doc/manual/build-md.sh).
# rebar3_ex_doc (see rebar.config) writes the HTML to the application's
# doc directory.
doc/manual/build-md.sh
rm -rf "$DOCDIR"
rebar3 ex_doc

WORKTREE=$(mktemp -d)
cleanup () {
    cd "$ROOT"
    git worktree remove --force "$WORKTREE" 2>/dev/null || true
    rm -rf -- "$WORKTREE"
    git worktree prune
}
trap cleanup EXIT

if git show-ref --verify --quiet refs/heads/gh-pages; then
    git worktree add -q "$WORKTREE" gh-pages
else
    git worktree add -q --orphan -b gh-pages "$WORKTREE"
fi

cd "$WORKTREE"
# Replace the previous contents, so that pages for removed modules go.
git rm -rq --ignore-unmatch .
cp -a "$ROOT/$DOCDIR/." .
git add -A

if git diff --cached --quiet; then
    echo "gh-pages: no changes"
else
    git status --short
    git commit -q -m "autocommit docs"
    echo "gh-pages: committed; not pushed"
fi
