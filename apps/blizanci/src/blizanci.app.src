{application, blizanci,
 [{description, "A Gemini protocol server"},
  {vsn, "5.33.0"},
  {registered, [blizanci_sup, blizanci_conf_serv, blizanci_servlets]},
  {mod, {blizanci_app, []}},
  {applications,
   [kernel,
    stdlib,
    runtime_tools,
    public_key,
    ssl,
    ranch,
    erlexec,
    realpath,
    mime_lookup,
    ppool
   ]},
  {env,
   [{port, 1965},
    {servlets, [blizanci_static, blizanci_cgi, blizanci_titan]}]},
  {licenses, ["Apache-2.0"]},
  {links, []}
 ]}.
