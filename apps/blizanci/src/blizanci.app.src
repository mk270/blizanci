{application, blizanci,
 [{description, "A Gemini protocol server"},
  {vsn, "5.19.0"},
  {registered, [blizanci_sup, blizanci_conf_serv]},
  {mod, {blizanci_app, []}},
  {applications,
   [kernel,
    stdlib,
    runtime_tools,
    ranch,
    erlexec,
    realpath,
    mime_lookup,
    ppool
   ]},
  {env,
   [{port, 1965},
    {servlets, [blizanci_static, blizanci_cgi, blizanci_titan]}]},
  {modules, [blizanci_app,
             blizanci_auth,
             blizanci_cgi,
             blizanci_config,
             blizanci_conf_serv,
             blizanci_connection,
             blizanci_log,
             blizanci_osenv,
             blizanci_path,
             blizanci_pool,
             blizanci_request,
             blizanci_router,
             blizanci_servlet,
             blizanci_servlet_container,
             blizanci_static,
             blizanci_sup,
             blizanci_titan,
             blizanci_tmpdir,
             blizanci_x509
            ]},
  {licenses, ["Apache 2.0"]},
  {links, []}
 ]}.
