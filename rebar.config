{erl_opts, [debug_info,
            warnings_as_errors
           ]}.

{minimum_otp_vsn, "27"}.

{deps, [
       {ranch, "2.0.0"},
       {erlexec, "2.4.0"},
       realpath,
       ppool,
       mime_lookup
]}.

{project_plugins, [rebar3_ex_doc]}.

{ex_doc, [
    {extras, ["doc/overview.md"]},
    {main, "overview"},
    {api_reference, true}
]}.

%{dialyzer, [{warnings, [underspecs,overspecs]}]}.
{dialyzer, [{plt_extra_apps, [public_key, eunit, ssl, ranch]},
            {warnings, [unknown]}]}.