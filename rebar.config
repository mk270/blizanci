{erl_opts, [debug_info,
            warnings_as_errors
           ]}.

{minimum_otp_vsn, "27"}.

{deps, [
       {ranch, "2.0.0"},
       {erlexec, "2.4.0"},
       realpath,
       ppool,
       mime_lookup
]}.

{edoc_opts, [{title, "Blizanci - a Gemini server."}]}.

%{dialyzer, [{warnings, [underspecs,overspecs]}]}.
{dialyzer, [{plt_extra_apps, [public_key, eunit, ssl, ranch]},
            {warnings, [unknown]}]}.