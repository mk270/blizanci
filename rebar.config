{erl_opts, [debug_info,
            warnings_as_errors
           ]}.

{minimum_otp_vsn, "27"}.

{deps, [
       {ranch, "2.0.0"},
       {erlexec, "2.4.0"},
       realpath,
       ppool,
       mime_lookup
]}.

{project_plugins, [rebar3_ex_doc]}.

{ex_doc, [
    {extras, [{"doc/manual/md/index.md", #{filename => "manual",
                                           title => "Manual"}},
              "doc/manual/md/configuration.md",
              "doc/manual/md/routing.md",
              "doc/manual/md/authorisation.md",
              "doc/manual/md/servlets.md",
              "doc/manual/md/cgi.md",
              "doc/manual/md/titan-and-static.md",
              "doc/manual/md/request-handling.md",
              "doc/manual/md/internals.md",
              "doc/manual/md/logging.md"]},
    {main, "manual"},
    {api_reference, true}
]}.

%{dialyzer, [{warnings, [underspecs,overspecs]}]}.
{dialyzer, [{plt_extra_apps, [public_key, eunit, ssl, ranch, common_test]},
            {warnings, [unknown]}]}.